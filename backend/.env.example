PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/studentManagement
MONGODB_DB_NAME=studentManagement

# Super Admin Bootstrap Configuration (Used by npm run seed:super-admin)
SUPER_ADMIN_NAME="Platform Administrator"
SUPER_ADMIN_EMAIL="admin@platform.example.com"
SUPER_ADMIN_PASSWORD="ChangeMeInProduction123!"
BCRYPT_SALT_ROUNDS=12
SUPER_ADMIN_EMAIL_VERIFIED=true

# JWT Authentication Configuration (Must be >= 32 characters / 256 bits)
JWT_ACCESS_SECRET=your_minimum_32_character_long_access_secret_here!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_minimum_32_character_long_refresh_secret_here!
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=education-management-system
JWT_AUDIENCE=education-management-users

# CORS Configuration (Comma-separated whitelisted frontend origins)
# For Vercel production: add your vercel deployment URL (e.g. https://my-school.vercel.app)
# Adding https://*.vercel.app or any domain ending in .vercel.app automatically supports Vercel previews
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend.vercel.app

# Swagger Configuration (Set to false or omit in production)
ENABLE_SWAGGER=false

# Security & Cookie Configuration
# For Vercel cross-domain hosting (Frontend on vercel.app, Backend on Render/Railway/AWS):
# Set COOKIE_SAME_SITE=none (Backend enforces SameSite=None; Secure for cross-origin HttpOnly cookies)
# For single-domain or local development: use COOKIE_SAME_SITE=lax
COOKIE_SAME_SITE=lax
REQUIRE_EMAIL_VERIFICATION=false
